# Copy to .env and adjust. Non-secret settings only: secrets are files in
# secrets/ (create them with: python scripts/generate_dev_secrets.py).

# Local development (defaults)
GATEWAY_HOST=localhost
GATEWAY_TLS_ISSUER=internal
GATEWAY_PORT=8443
GATEWAY_HTTP_PORT=8080
TURN_HOST=localhost
TURN_EXTERNAL_IP=127.0.0.1

# Server: replace the block above with
#   GATEWAY_HOST=<DNS name>        e.g. medvitals.<region>.cloudapp.azure.com
#   GATEWAY_TLS_ISSUER=acme        Let's Encrypt certificate
#   GATEWAY_PORT=443
#   GATEWAY_HTTP_PORT=80           needed for the certificate challenge
#   TURN_HOST=<DNS name>
#   TURN_EXTERNAL_IP=<public IP>
