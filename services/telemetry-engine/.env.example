# Copy to .env for local runs. Never commit real values.
ENGINE_DATABASE_URL=sqlite+aiosqlite:///./telemetry.db
# ENGINE_REDIS_URL=redis://localhost:6379/0
ENGINE_ENCRYPTION_KEY=<32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())">
ENGINE_DEVICE_API_KEYS=["<simulator key>"]
ENGINE_JWKS_URL=http://localhost:4000/.well-known/jwks.json
