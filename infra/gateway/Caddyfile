# MedVitals API gateway: the only service reachable from outside.
# TLS 1.3 only. /auth, /patients and /.well-known go to identity; the rest to the engine.

# Certificates:
#   local   GATEWAY_TLS_ISSUER=internal  Caddy's own development CA
#   server  GATEWAY_TLS_ISSUER=acme      Let's Encrypt, for GATEWAY_HOST (a real
#           DNS name pointing at the server; it must reach ports 80/443)
# Caddy listens on 443 (and 80 for the Let's Encrypt challenge and redirects)
# inside the container; docker-compose maps them to the host's ports.
{
	admin off
}

{$GATEWAY_HOST:localhost} {
	tls {
		protocols tls1.3 tls1.3
		issuer {$GATEWAY_TLS_ISSUER:internal}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Identity Service: accounts, tokens, the patient directory, public keys.
	@identity path /auth/* /patients /.well-known/*
	handle @identity {
		reverse_proxy identity:4000
	}

	# Telemetry Engine: ingestion, history, escalations, WebSocket streams.
	handle {
		reverse_proxy engine:8000
	}

	# Access log without query strings: WebSocket URLs carry tokens.
	log {
		format filter {
			request>uri query {
				delete token
			}
		}
	}
}
